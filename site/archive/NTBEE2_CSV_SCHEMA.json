  "key_classes": {
    "DeviceModel": {
      "purpose": "Polynomial-fitted model with temperature scaling",
      "uses": "Loss calculations for switching/conduction",
      "factory_methods": ["from_config()"],
      "properties": [
        "Rds_coeffs: [a0, a1, a2, a3] for R_ds = a0 + a1×V + a2×V² + a3×V×I [mOhm]",
        "Eon_coeffs: [b0, b1, b2, b3] for E_on = b0 + b1×V + b2×I + b3×V×I [µJ]",
        "Eoff_coeffs: [c0, c1, c2, c3] for E_off = c0 + c1×V + c2×I + c3×V×I [µJ]",
        "alpha_T: R_ds temperature coefficient [1/K] (default 0.004)",
        "beta_T: E_sw temperature coefficient [1/K] (default 0.002)"
      ]
    },
    "Semiconductor": {
      "purpose": "Leibl-compatible measurement-based model with 2-D interpolation",
      "uses": "Loss calculations from measured data points",
      "factory_methods": ["from_datasheet()", "from_config()"],
      "data_structure": {
        "switching_data": {
          "transistor_on": {"voltage": [], "current": [], "energy": []},
          "transistor_off": {"voltage": [], "current": [], "energy": []},
          "diode_on": {"voltage": [], "current": [], "energy": []},
          "diode_off": {"voltage": [], "current": [], "energy": []}
        },
        "conducting_data": {
          "forward": {"resistance": "float or voltage/current arrays"},
          "reverse": {"resistance": "float"}
        },
        "thermal_data": {
          "transistor": {"thermal_resistance": "float", "rated_junction_temperature": "float"},
          "diode": {"thermal_resistance": "float", "rated_junction_temperature": "float"}
        }
      }
    }
  },
  "integration_notes": {
    "unit_conversions": {
      "voltage": "[V] ← V_br_V, V_test_V, V_ce_sat_V, V_class_V, U_f_V",
      "resistance": "[mOhm] ← R_dson_mOhm, R_d_mOhm, R_f_mOhm → [Ohm] for loss calculations (÷1000)",
      "thermal_resistance": "[K/W] ← Rth_jc_* directly in Kelvin/Watt",
      "energy": "[µJ] ← E_on_uJ, E_off_uJ, a_*_uJ → [J] for loss calculations (÷1e6)",
      "current": "[A] ← I_test_A, k_*_uJ_A, k_RR_uJ_A directly in Amperes"
    },
    "matching_tdb_to_ntbee2": {
      "TDB_metadata.name": "→ ntbee2.part_number",
      "TDB_metadata.type": "→ ntbee2.type (mosfet|igbt|diode)",
      "TDB_metadata.manufacturer": "→ ntbee2.vendor",
      "TDB_electrical_ratings.v_abs_max": "→ ntbee2.V_br_V",
      "TDB_electrical_ratings.i_abs_max": "→ ntbee2.I_test_A (proxy)",
      "TDB_electrical_ratings.t_j_max": "→ ntbee2 thermal_data.rated_junction_temperature",
      "TDB_switch.channel_data[0].r_channel": "→ ntbee2.R_dson_mOhm (at 25°C, V_gs=15V)",
      "TDB_switch.e_on_data[0]": "→ ntbee2.E_on_uJ (at test point V, I)",
      "TDB_switch.e_off_data[0]": "→ ntbee2.E_off_uJ (at test point V, I)",
      "TDB_thermal_properties.r_th_jc": "→ ntbee2.Rth_jc_KW",
      "note": "TDB uses detailed curve data; ntbee2 uses single test points + Raggl coefficients"
    },
    "reverse_matching_ntbee2_to_tdb": {
      "ntbee2.part_number": "→ TDB_metadata.name",
      "ntbee2.type": "→ TDB_metadata.type",
      "ntbee2.vendor": "→ TDB_metadata.manufacturer",
      "ntbee2.V_br_V": "→ TDB_electrical_ratings.v_abs_max",
      "ntbee2.R_dson_mOhm×1e-3": "→ TDB_switch.channel_data[0].r_channel",
      "ntbee2.E_on_uJ×1e-6": "→ TDB_switch.e_on_data[0].energy (synthesized single point)",
      "ntbee2.E_off_uJ×1e-6": "→ TDB_switch.e_off_data[0].energy (synthesized single point)",
      "note": "Raggl coefficients have no direct TDB equivalent; conversion loses model detail"
    },
    "critical_differences": [
      "ntbee2 plecs_devices.csv: Single test point (V_test_V, I_test_A) for switching energies",
      "ntbee2 raggl_combos.csv: Current-dependent Raggl model E(I) = a + k×I or a + k×I²",
      "TDB: Full curve data with multiple measurement points for interpolation",
      "ntbee2 raggl: Assumes sinusoidal PFC waveforms (special averaging formulas)",
      "ntbee2 units: Consistent [mOhm], [µJ], [K/W]; TDB uses [Ohm], [J], [K/W]"
    ]
  },
